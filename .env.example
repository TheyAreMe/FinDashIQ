# ==============================================================================
# ⚡ FinDashIQ - Environment Configuration
# ==============================================================================
# All settings below are optional. FinDashIQ works out-of-the-box with default
# values. Uncomment and populate any parameters you wish to customize.
# ==============================================================================

# ------------------------------------------------------------------------------
# 📧 1. OUTBOUND EMAIL (SMTP) NOTIFICATIONS
# ------------------------------------------------------------------------------
# Required ONLY if you select "Email Notification" in the Signal Alerts Hub
# and want FinDashIQ to dispatch direct emails from the server to your inbox.
#
# Examples:
#   Gmail:       SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 (Requires Google App Password)
#   Outlook/365: SMTP_HOST=smtp.office365.com | SMTP_PORT=587
#   Mailgun:     SMTP_HOST=smtp.mailgun.org | SMTP_PORT=587
#   SendGrid:    SMTP_HOST=smtp.sendgrid.net | SMTP_PORT=587

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password
# SMTP_FROM=FinDashIQ Alerts <alerts@findashiq.com>


# ------------------------------------------------------------------------------
# 📱 2. TELEGRAM BOT NOTIFICATIONS
# ------------------------------------------------------------------------------
# Optional server-level Bot API Token. If set, FinDashIQ can dispatch messages
# to any user ID or channel (e.g. @quant_desk) via the official Telegram Bot API.
#
# How to get a token:
#   1. Message @BotFather on Telegram.
#   2. Send /newbot and follow prompts.
#   3. Copy the token given by @BotFather.

# TELEGRAM_BOT_TOKEN=<TOKEN>


# ------------------------------------------------------------------------------
# 🧠 3. GOOGLE GEMINI AI SYNTHESIS
# ------------------------------------------------------------------------------
# Optional server-level Gemini API Key for quantitative consensus summaries,
# scenario models, and interactive AI copilot analysis.
# (Note: Standard users can also configure their key directly in the web UI).
#
# How to get a key:
#   1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
#   2. Create a free API key.

# GEMINI_API_KEY=<YourGeneratedGeminiApiKeyHere>
